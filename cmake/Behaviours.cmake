# 明示的な一覧だけを使い、ソース登録と実行時登録を同時に生成する。
set(CHROMALIS_BEHAVIOUR_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Gameplay/Behaviours" CACHE PATH "Behaviour authoring directory")
set(manifest "${CHROMALIS_BEHAVIOUR_DIR}/behaviours.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
file(READ "${manifest}" definitions)
string(JSON version GET "${definitions}" version)
if(NOT version EQUAL 1)
  message(FATAL_ERROR "Unsupported Behaviour manifest")
endif()
string(JSON count LENGTH "${definitions}" entries)
set(includes "#include \"gameplay/Behaviour.h\"\n")
set(registration "namespace chromalis {\nvoid RegisterGameBehaviours(BehaviourRegistry& registry) {\n")
set(names)
set(ids)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON name GET "${definitions}" entries ${index} name)
    string(JSON id GET "${definitions}" entries ${index} id)
    string(TOLOWER "${name}" lower)
    if(NOT name MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR NOT id MATCHES "^[A-Za-z0-9_.-]+$" OR lower IN_LIST names OR id IN_LIST ids)
      message(FATAL_ERROR "Invalid/duplicate Behaviour entry: ${name}")
    endif()
    list(APPEND names "${lower}")
    list(APPEND ids "${id}")
    target_sources(ChromalisRuntime PRIVATE "${CHROMALIS_BEHAVIOUR_DIR}/${name}.h" "${CHROMALIS_BEHAVIOUR_DIR}/${name}.cpp")
    string(APPEND includes "#include \"${name}.h\"\n")
    string(APPEND registration "registry.Add(${name}::Describe(), \"${id}\");\n")
  endforeach()
endif()
string(APPEND registration "}\n}\n")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/BehaviourRegistration.cpp" CONTENT "${includes}${registration}" @ONLY)
target_sources(ChromalisRuntime PRIVATE src/gameplay/Behaviour.cpp "${CMAKE_CURRENT_BINARY_DIR}/generated/BehaviourRegistration.cpp")
target_include_directories(ChromalisRuntime PRIVATE "${CHROMALIS_BEHAVIOUR_DIR}")
target_link_libraries(ChromalisRuntime PUBLIC nlohmann_json::nlohmann_json)

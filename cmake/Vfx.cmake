include(FetchContent)
set(CHROMALIS_EFFEKSEER_ARCHIVE "https://github.com/effekseer/Effekseer/releases/download/1807/EffekseerForCpp1.80.7.zip" CACHE STRING "Effekseer 1.80.7 C++ archive URL or local path")
foreach(option IN ITEMS BUILD_EXAMPLES BUILD_EXAMPLE BUILD_TEST BUILD_TOOL BUILD_VIEWER BUILD_EDITOR BUILD_GL BUILD_DX9 BUILD_DX11 BUILD_VULKAN BUILD_METAL USE_OPENAL USE_XAUDIO2 USE_DSOUND)
  set(${option} OFF CACHE BOOL "Unused Effekseer component" FORCE)
endforeach()
set(BUILD_DX12 ON CACHE BOOL "DX12 renderer" FORCE)
set(USE_MSVC_RUNTIME_LIBRARY_DLL ON CACHE BOOL "Match host CRT" FORCE)
FetchContent_Declare(effekseer URL "${CHROMALIS_EFFEKSEER_ARCHIVE}"
  URL_HASH SHA256=92ba44ba838706f9f0cf0b0bc507e0a8a0427ef57793cecf29c5ca621a34c3b5)
FetchContent_MakeAvailable(effekseer)
foreach(target IN ITEMS Effekseer EffekseerRendererCommon EffekseerRendererLLGI EffekseerRendererDX12 LLGI)
  set_property(TARGET ${target} PROPERTY SYSTEM TRUE)
  target_compile_options(${target} PRIVATE /utf-8)
endforeach()
